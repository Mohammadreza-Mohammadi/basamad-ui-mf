{
  "name": "basamad-ui-mf",
  "version": "1.0.25",
  "description": "Basamad UI as a standalone Native Federation remote (mirrors the BarsaSvgMapReport pattern).",
  "scripts": {
    "ng": "ng",
    "prebuild": "npm version patch --no-git-tag-version",
    "version": "node scripts/sync-library-version.js",
    "build": "ng build basamad-ui-mf --configuration production && node scripts/zip-remote.js",
    "build:dev": "ng build basamad-ui-mf --configuration development",
    "serve": "ng serve basamad-ui-mf --port 4202",
    "build:lib": "ng build basamad-ui --configuration production"
  },
  "private": true,
